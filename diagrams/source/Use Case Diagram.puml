@startuml
title Use Case Diagram

left to right direction

skinparam linetype ortho
skinparam shadowing false
skinparam defaultFontName Arial
skinparam nodesep 45
skinparam ranksep 35
skinparam packageStyle rectangle

skinparam usecase {
  BackgroundColor White
  BorderColor #404040
}
skinparam actor {
  BorderColor #404040
}
skinparam ArrowColor #404040

actor "User" as User
actor "Project Developer" as Developer

rectangle "Air Quality Forecasting System" {
  usecase "View current air quality" as UC1
  usecase "View air quality forecast" as UC2
  usecase "View historical data" as UC3
  usecase "Select forecast parameters" as UC4
  usecase "Manage data and configuration" as UC5

  UC1 -[hidden]down- UC2
  UC2 -[hidden]down- UC3
  UC3 -[hidden]down- UC4
  UC4 -[hidden]down- UC5
}

User -right-> UC1
User -right-> UC2
User -right-> UC3
User -right-> UC4

Developer -right-> UC5
@enduml
